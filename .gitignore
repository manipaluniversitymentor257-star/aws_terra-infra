
# Terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive local configuration
.terraformrc
terraform.rc

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary AWS diagnostics
instance-*.txt
ssm-*.json
refresh-preferences.json
